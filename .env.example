# CommonGround — Full-Stack Supabase Configuration
#
# IMPORTANT:
# 1. Copy this file to .env.local or .env
# 2. Fill in your project URL and public Anon Key from your Supabase Dashboard:
#    Project Settings -> API -> Project URL & Project API Keys (anon public)
# 3. NEVER put your service_role secret key in this file or any client bundle!

# Your Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon (Public) Key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
